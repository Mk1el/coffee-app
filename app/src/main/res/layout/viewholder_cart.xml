<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- White Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/white_bg"
        android:elevation="2dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Product Image with Rounded Corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewPic"
            android:layout_width="85dp"
            android:layout_height="85dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/picCart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Product Title -->
        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="32dp"
            android:text="title"
            android:textColor="@color/darkBrown"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardViewPic"
            app:layout_constraintTop_toTopOf="@+id/cardViewPic" />

        <!-- Price per Item -->
        <TextView
            android:id="@+id/feeEachItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="$0"
            android:textColor="@color/darkBrown"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/cardViewPic"
            app:layout_constraintTop_toBottomOf="@+id/titleTxt" />

        <!-- Minus Button (-) -->
        <TextView
            android:id="@+id/minusEachItem"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/orange_circle_bg"
            android:gravity="center"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/cardViewPic"
            app:layout_constraintStart_toEndOf="@+id/cardViewPic"
            app:layout_constraintTop_toBottomOf="@+id/feeEachItem" />

        <!-- Quantity Text -->
        <TextView
            android:id="@+id/numberItemTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="0"
            android:textColor="@color/darkBrown"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/minusEachItem"
            app:layout_constraintStart_toEndOf="@+id/minusEachItem"
            app:layout_constraintTop_toTopOf="@+id/minusEachItem" />

        <!-- Plus Button (+) -->
        <TextView
            android:id="@+id/plusEachItem"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/orange_circle_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/minusEachItem"
            app:layout_constraintStart_toEndOf="@+id/numberItemTxt"
            app:layout_constraintTop_toTopOf="@+id/minusEachItem" />

        <!-- Total Price for Item -->
        <TextView
            android:id="@+id/totalEachItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="$0"
            android:textColor="@color/darkBrown"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/plusEachItem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/plusEachItem" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Delete / Remove Button (Overlapping top-right corner) -->
    <ImageView
        android:id="@+id/removeItemBtn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout2"
        app:layout_constraintEnd_toEndOf="@+id/constraintLayout2"
        app:layout_constraintStart_toEndOf="@+id/constraintLayout2"
        app:layout_constraintTop_toTopOf="@+id/constraintLayout2"
        app:srcCompat="@drawable/ic_close_circle" />

</androidx.constraintlayout.widget.ConstraintLayout>